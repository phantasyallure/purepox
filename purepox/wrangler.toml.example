# Local development only — copy to wrangler.toml (which is git-ignored).
# Do NOT commit a wrangler.toml: in production the bindings are set in the Cloudflare dashboard.
name = "purepox"
compatibility_date = "2025-06-01"
pages_build_output_dir = "dist"

[[d1_databases]]
binding = "DB"
database_name = "purepox"
database_id = "local-test"

[[r2_buckets]]
binding = "IMAGES"
bucket_name = "purepox-images"
