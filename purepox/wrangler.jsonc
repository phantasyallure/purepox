{
  "name": "purepox",
  "main": "worker/index.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "purepox", "database_id": "3d7873f4-7e92-44f5-b424-5293998f132f" }
  ]
}
